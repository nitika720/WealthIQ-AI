# WealthIQ AI Engine Configuration Environment Template

# Port configuration
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI Copilot API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT Authentication Secret
JWT_SECRET="wealthiq-super-secure-production-jwt-key-2026"
JWT_EXPIRES_IN="7d"

# Standalone MongoDB Connection URI (Optional)
# If left empty, WealthIQ uses the high-performance local persistent atomic JSON store with ACID-safe snapshots.
MONGODB_URI=""

# Python ML Microservice URL (Optional for multi-container deployment)
ML_SERVICE_URL="http://localhost:8000"

# Application Base URL
APP_URL="MY_APP_URL"
